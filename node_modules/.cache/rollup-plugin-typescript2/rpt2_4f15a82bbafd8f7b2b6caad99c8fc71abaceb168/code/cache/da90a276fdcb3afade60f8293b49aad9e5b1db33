{"code":"import fs from \"fs\";\nexport function loadMemoFile(filename) {\n    if (!fs.existsSync(filename)) {\n        return undefined;\n    }\n    const text = fs.readFileSync(filename, \"utf-8\");\n    const obj = JSON.parse(text);\n    return obj;\n}\nexport function writeMemoFile(filename, obj) {\n    const text = JSON.stringify(obj);\n    try {\n        fs.writeFileSync(filename, text);\n    }\n    catch (e) {\n        return false;\n    }\n    return true;\n}\n","references":["/Users/sunaga/project/work/app/node-tool/ez-pass-manager/src/types.ts"]}
